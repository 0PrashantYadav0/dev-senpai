# At least one chat provider key is required. Groq is the recommended
# safety net: fast and with a generous free tier. Gemini and ChatGPT are
# offered to visitors as options and fall back to Groq when their quota
# runs out.
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# Optional model overrides.
# GROQ_MODEL=openai/gpt-oss-120b
# GEMINI_MODEL=gemini-2.5-flash
# OPENAI_MODEL=gpt-4.1-mini

# Optional per-provider budgets (requests per minute / per day). The route
# stops calling a provider before these are exceeded and falls back instead.
# Defaults are conservative free-tier numbers.
# GROQ_RPM=28
# GROQ_RPD=12000
# GEMINI_RPM=8
# GEMINI_RPD=200
# OPENAI_RPM=3
# OPENAI_RPD=200

# Contact form (Resend).
RESEND_API_KEY=

# Optional. Raises the GitHub API limit for the live merged-PR count on the
# home page (unauthenticated is 10 searches a minute, cached for an hour).
# GITHUB_TOKEN=
